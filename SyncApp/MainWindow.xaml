<Window x:Class="SyncApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SyncApp"
        mc:Ignorable="d"
        Title="Sync App Configuration" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source Database Configuration -->
        <GroupBox Grid.Row="0" Header="Source Database (Local SQL Server)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server Instance:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Name="cmbSourceServer" IsEditable="True"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Detect" Click="DetectServers_Click" MinWidth="80"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="cmbSourceDatabase" IsEditable="True"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Load DBs" Click="LoadSourceDatabases_Click" MinWidth="80"/>

                <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="chkSourceWindowsAuth" 
                          Content="Use Windows Authentication" IsChecked="True" 
                          Checked="SourceWindowsAuth_Changed" Unchecked="SourceWindowsAuth_Changed"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="5" Name="lblSourceUsername"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="txtSourceUsername" IsEnabled="False"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="5" Name="lblSourcePassword"/>
                <PasswordBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Name="txtSourcePassword" IsEnabled="False" Margin="5" Padding="5"/>

                <Button Grid.Row="5" Grid.Column="1" Content="Test Connection" Click="TestSourceConnection_Click" HorizontalAlignment="Left"/>
            </Grid>
        </GroupBox>

        <!-- Cloud Database Configuration -->
        <GroupBox Grid.Row="1" Header="Cloud Database (Target SQL Server)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server/IP:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="txtCloudServer"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="txtCloudDatabase"/>

                <CheckBox Grid.Row="2" Grid.Column="1" Name="chkCloudWindowsAuth" 
                          Content="Use Windows Authentication" IsChecked="False"
                          Checked="CloudWindowsAuth_Changed" Unchecked="CloudWindowsAuth_Changed"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="5" Name="lblCloudUsername"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="txtCloudUsername"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="5" Name="lblCloudPassword"/>
                <PasswordBox Grid.Row="4" Grid.Column="1" Name="txtCloudPassword" Margin="5" Padding="5"/>

                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Test Connection" Click="TestCloudConnection_Click" HorizontalAlignment="Left" Margin="5"/>
            </Grid>
        </GroupBox>

        <!-- Table Selection -->
        <GroupBox Grid.Row="2" Header="Select Tables to Sync">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="Load Tables" Click="LoadTables_Click" HorizontalAlignment="Left"/>
                
                <ListView Grid.Row="1" Name="lvTables" Margin="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Select" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Schema" DisplayMemberBinding="{Binding Schema}" Width="100"/>
                            <GridViewColumn Header="Table Name" DisplayMemberBinding="{Binding TableName}" Width="Auto"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox Name="chkRunOnStartup" Content="Run on Windows Startup" VerticalAlignment="Center" Margin="5"/>
            <Button Content="Save Configuration" Click="SaveConfiguration_Click" Background="#FF4CAF50" Foreground="White"/>
            <Button Content="Minimize to Tray" Click="MinimizeToTray_Click"/>
        </StackPanel>
    </Grid>
</Window>
